#!/bin/bash

set -euo pipefail

DIR="$1"
URL="$2"

export GIT_TERMINAL_PROMPT=0

if [ -d "$DIR" ]
then (
	cd "$DIR" || exit
	ACTUALURL="$(git config --get remote.origin.url)"
	if [ "$URL" != "$ACTUALURL" ]
	then
		echo "Updating origin for $DIR"
		git remote set-url origin "$URL"
		git remote prune origin
	fi
) fi

if [ ! -d "$DIR" ]
then
	echo "Cloning $DIR";
	git clone --no-checkout "$URL" "$DIR" || exit
fi
